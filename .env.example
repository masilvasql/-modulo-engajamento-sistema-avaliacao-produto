# Supabase (Project Settings > API). Usadas apenas no servidor; nunca exponha com NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...) ou a chave legada service_role
SUPABASE_SECRET_KEY=

# Segredo para assinar o cookie de sessão (mín. 32 caracteres). Ex.: openssl rand -base64 32
SESSION_SECRET=

# OpenAI (agente Mastra de resumo das avaliações)
OPENAI_API_KEY=
